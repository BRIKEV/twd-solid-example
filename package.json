{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "json-server --watch data/data.json --routes data/routes.json --port 3001",
    "serve:dev": "npm-run-all --parallel serve dev",
    "dev:ci": "CI=true vite",
    "test:ci": "npx twd-cli run",
    "collect:coverage:text": "npx nyc report --reporter=text --temp-dir .nyc_output",
    "collect:coverage:html": "npx nyc report --reporter=html --temp-dir .nyc_output",
    "collect:coverage:lcov": "npx nyc report --reporter=lcov --temp-dir .nyc_output"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "nyc": "^18.0.0",
    "solid-devtools": "^0.34.5",
    "twd-cli": "1.10.0",
    "twd-js": "1.12.0-beta.0",
    "twd-relay": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-solid": "^2.11.10"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.2",
    "json-server": "^0.17.4",
    "npm-run-all": "^4.1.5",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.1.18"
  },
  "overrides": {
    "twd-relay": {
      "twd-js": "$twd-js"
    }
  }
}
